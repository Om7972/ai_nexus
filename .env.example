# ============================================
# AI NEXUS - Frontend Environment Variables
# ============================================
# Copy to .env for local development.
# On Netlify, add these in Site settings → Environment variables.

# Backend API (required for production)
VITE_API_URL=http://localhost:5000/api/v1

# Optional: only if you use client-side Gemini features
VITE_GEMINI_API_KEY=

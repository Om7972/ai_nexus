# ============================================
# AI NEXUS - ENVIRONMENT VARIABLES
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
VITE_API_URL=http://localhost:5000/api/v1
FRONTEND_URL=http://localhost:3000

# ============================================
# DATABASE
# ============================================
MONGO_URI=mongodb://localhost:27017/ai_nexus
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=securepassword
MONGO_DB_NAME=ai_nexus

# ============================================
# REDIS CACHE
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redispassword
REDIS_URL=redis://:redispassword@localhost:6379

# ============================================
# JWT AUTHENTICATION
# ============================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key
JWT_REFRESH_EXPIRES_IN=30d

# ============================================
# OPENAI API
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# ============================================
# CLOUDINARY (Image Storage)
# ============================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# EMAIL SERVICE (SMTP)
# ============================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=AI Nexus <noreply@ainexus.com>

# ============================================
# RATE LIMITING
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000

# ============================================
# SECURITY
# ============================================
CSRF_SECRET=your-csrf-secret-key
COOKIE_SECRET=your-cookie-secret-key

# ============================================
# MONITORING (Optional)
# ============================================
SENTRY_DSN=your-sentry-dsn
DATADOG_API_KEY=your-datadog-key

# ============================================
# AWS (Optional - for production deployment)
# ============================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# ============================================
# VERCEL (for frontend deployment)
# ============================================
# These are automatically set by Vercel
# VERCEL_URL=
# VERCEL_ENV=

# ============================================
# RENDER (for backend deployment)
# ============================================
# Set these in Render dashboard
# RENDER_EXTERNAL_URL=
# RENDER_SERVICE_NAME=

# ============================================
# RAILWAY (alternative deployment)
# ============================================
# Set these in Railway dashboard
# RAILWAY_ENVIRONMENT=
# RAILWAY_SERVICE_NAME=
